@page "/unitconverter"
@rendermode InteractiveServer

<PageTitle>Unit Converter Light</PageTitle>

<h1>Unit Converter Light</h1>

<div class="converter">

    <div class="mb-3">
        <label>Value:</label>
        <input type="number" class="form-control" @bind="inputValue" />
    </div>

    <div class="mb-3">
        <label>Category:</label>
        <select class="form-select" @bind="selectedCategory" @bind:after="OnCategoryChanged">
            @foreach (var c in categories)
            {
                <option value="@c">@c</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>From:</label>
        <select class="form-select" @bind="fromUnit">
            @foreach (var u in units)
            {
                <option value="@u">@u</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>To:</label>
        <select class="form-select" @bind="toUnit">
            @foreach (var u in units)
            {
                <option value="@u">@u</option>
            }
        </select>
    </div>

    <button class="btn btn-primary" @onclick="Convert">Convert</button>

    @if (result is not null)
    {
        <p class="mt-3">Result: <strong>@result</strong></p>
    }
</div>

@code {
    private double inputValue;
    private double? result;

    private string selectedCategory = "Length";
    private string fromUnit = "meter";
    private string toUnit = "kilometer";

    // All categories grouped together
    private readonly Dictionary<string, Dictionary<string, double>> allCategories =
        new()
        {
            {
                "Length",
                new Dictionary<string, double>
                {
                    { "millimeter", 0.001 },
                    { "centimeter", 0.01 },
                    { "meter", 1 },
                    { "kilometer", 1000 },
                    { "inch", 0.0254 },
                    { "foot", 0.3048 },
                    { "yard", 0.9144 },
                    { "mile", 1609.34 }
                }
            },
            {
                "Data",
                new Dictionary<string, double>
                {
                    { "bit", 1.0 / 8.0 },
                    { "byte", 1 },
                    { "kilobyte", 1024 },
                    { "megabyte", 1024 * 1024 },
                    { "gigabyte", 1024 * 1024 * 1024 },
                    { "terabyte", 1024d * 1024 * 1024 * 1024 }
                }
            }
        };

    private IEnumerable<string> categories => allCategories.Keys;

    private IEnumerable<string> units => allCategories[selectedCategory].Keys;

    private void OnCategoryChanged()
    {
        // @bind has already updated selectedCategory.
        // Reset units when category changes.
        fromUnit = units.First();
        toUnit = units.Last();

        result = null;
    }

    private void Convert()
    {
        var factors = allCategories[selectedCategory];

        var baseValue = inputValue * factors[fromUnit];
        result = baseValue / factors[toUnit];
    }
}
