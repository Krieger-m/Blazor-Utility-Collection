@page "/unitconverter"
@rendermode InteractiveServer

<PageTitle>Unit Converter Light</PageTitle>

<h1>Unit Converter Light</h1>

<div class="converter">

<div class="mb-3">
    <label>Value:</label>
    <input type="number" class="form-control" @bind="inputValue" />
</div>

<div class="mb-3">
    <label>From:</label>
    <select class="form-select" @bind="fromUnit">
        @foreach (var u in units)
        {
            <option value="@u">@u</option>
        }
    </select>
</div>

<div class="mb-3">
    <label>To:</label>
    <select class="form-select" @bind="toUnit">
        @foreach (var u in units)
        {
            <option value="@u">@u</option>
        }
    </select>
</div>

<button class="btn btn-primary" @onclick="Convert">Convert</button>

@if (result is not null)
{
    <p class="mt-3">Result: <strong>@result</strong></p>
}
</div>


@code {
    private double inputValue;
    private double? result;

    private string fromUnit = "meter";
    private string toUnit = "kilometer";

    // Conversion factors relative to 1 meter
    private readonly Dictionary<string, double> lengthFactors = new()
    {
        { "millimeter", 0.001 },
        { "centimeter", 0.01 },
        { "meter", 1 },
        { "kilometer", 1000 },
        { "inch", 0.0254 },
        { "foot", 0.3048 },
        { "yard", 0.9144 },
        { "mile", 1609.34 }
    };

    private IEnumerable<string> units => lengthFactors.Keys;

    private void Convert()
    {
        // Convert input to meters
        var meters = inputValue * lengthFactors[fromUnit];

        // Convert meters to target unit
        result = meters / lengthFactors[toUnit];
    }
}
